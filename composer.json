{
  "name": "fyldo/fyldo",
  "description": "Settings-page framework for WordPress plugin developers: declare pages, sections and fields in PHP; get a modern React admin UI with REST-backed validation and saving.",
  "type": "library",
  "license": "GPL-2.0-or-later",
  "keywords": ["wordpress", "settings", "options", "admin", "react"],
  "homepage": "https://github.com/fyldo/fyldo",
  "require": {
    "php": ">=7.4"
  },
  "require-dev": {
    "phpunit/phpunit": "^9.6",
    "yoast/phpunit-polyfills": "^2.0 || ^3.0 || ^4.0"
  },
  "autoload": {
    "files": [ "fyldo.php" ]
  },
  "autoload-dev": {
    "psr-4": {
      "Fyldo\\V1\\": "src/",
      "Fyldo\\Tests\\": "tests/php/"
    }
  },
  "config": {
    "sort-packages": true,
    "allow-plugins": {}
  },
  "scripts": {
    "test": "@php -d auto_prepend_file=tests/php/prepend.php vendor/bin/phpunit --testsuite unit"
  },
  "minimum-stability": "stable"
}
