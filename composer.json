{
  "name": "fyldo/fyldo",
  "description": "Settings-page framework for WordPress plugin developers: declare pages, sections and fields in PHP; get a modern React admin UI with REST-backed validation and saving.",
  "type": "library",
  "license": "GPL-2.0-or-later",
  "keywords": [
    "wordpress",
    "settings",
    "options",
    "admin",
    "react"
  ],
  "homepage": "https://github.com/fyldo/fyldo",
  "require": {
    "php": ">=7.4"
  },
  "require-dev": {
    "dealerdirect/phpcodesniffer-composer-installer": "^1.0",
    "php-stubs/wordpress-stubs": "^6.7",
    "phpcompatibility/phpcompatibility-wp": "^2.1",
    "phpstan/phpstan": "^2.0",
    "phpunit/phpunit": "^9.6",
    "squizlabs/php_codesniffer": "^3.10",
    "szepeviktor/phpstan-wordpress": "^2.0",
    "wp-coding-standards/wpcs": "^3.1",
    "yoast/phpunit-polyfills": "^2.0 || ^3.0 || ^4.0"
  },
  "autoload": {
    "files": [
      "fyldo.php"
    ]
  },
  "autoload-dev": {
    "psr-4": {
      "Fyldo\\V1\\": "src/",
      "Fyldo\\Tests\\": "tests/php/"
    }
  },
  "config": {
    "sort-packages": true,
    "allow-plugins": {
      "dealerdirect/phpcodesniffer-composer-installer": true
    }
  },
  "scripts": {
    "test": "phpunit --testsuite unit",
    "lint": "phpcs --standard=phpcs.xml.dist",
    "analyse": "phpstan analyse --no-progress --memory-limit=1G"
  },
  "minimum-stability": "stable"
}
