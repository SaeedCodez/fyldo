includes:
	- vendor/szepeviktor/phpstan-wordpress/extension.neon

parameters:
	level: 8
	paths:
		- src
		- demo
		- fyldo.php
	treatPhpDocTypesAsCertain: false
	ignoreErrors:
		# Array shapes are documented in prose/PHPDoc where it matters; this identifier is pure noise at level 8.
		- identifier: missingType.iterableValue
