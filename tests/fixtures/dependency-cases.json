{
  "description": "Conditions of `dependency` (src/Schema/Dependency.php, app/lib/dependency.ts): holds(operator, value, target). Run by PHPUnit (DependencyTest) and Vitest (dependency.test.ts). `value` is the field's value as the browser and the server hold it.",
  "holds": [
    { "operator": "==", "value": true, "target": true, "expected": true, "note": "toggle on" },
    { "operator": "==", "value": false, "target": true, "expected": false },
    { "operator": "==", "value": true, "target": "true", "expected": true, "note": "Codestar style: a toggle compared with 'true'" },
    { "operator": "==", "value": false, "target": "false", "expected": true },
    { "operator": "==", "value": true, "target": 1, "expected": true },
    { "operator": "==", "value": false, "target": "0", "expected": true },
    { "operator": "==", "value": false, "target": "", "expected": true },
    { "operator": "!=", "value": true, "target": true, "expected": false },
    { "operator": "==", "value": "redis", "target": "redis", "expected": true },
    { "operator": "==", "value": "Redis", "target": "redis", "expected": false, "note": "text is case sensitive" },
    { "operator": "==", "value": 5, "target": "5", "expected": true, "note": "a number and a numeric text compare as numbers" },
    { "operator": "==", "value": 5, "target": 5.0, "expected": true },
    { "operator": "==", "value": 2.5, "target": "2.5", "expected": true },
    { "operator": "==", "value": "05", "target": "5", "expected": false, "note": "two texts compare as text" },
    { "operator": "==", "value": "", "target": null, "expected": true },
    { "operator": "==", "value": ["a", "b"], "target": "b", "expected": true, "note": "a list equals a value it holds" },
    { "operator": "==", "value": ["a", "b"], "target": ["b", "a"], "expected": true, "note": "or a list with the same values" },
    { "operator": "==", "value": ["a", "b"], "target": ["a"], "expected": false },
    { "operator": "!=", "value": ["a", "b"], "target": "c", "expected": true },
    { "operator": "!=", "value": "", "target": "", "expected": false },
    { "operator": ">", "value": 10, "target": 5, "expected": true },
    { "operator": ">", "value": 5, "target": 5, "expected": false },
    { "operator": ">=", "value": 5, "target": "5", "expected": true },
    { "operator": "<", "value": "3", "target": 10, "expected": true, "note": "numeric texts compare by size, not by character" },
    { "operator": "<=", "value": 11, "target": 10, "expected": false },
    { "operator": ">", "value": "", "target": 5, "expected": false, "note": "an empty number field cannot be ordered" },
    { "operator": ">", "value": true, "target": 0, "expected": false },
    { "operator": ">", "value": "2026-05-01", "target": "2026-04-30", "expected": true, "note": "dates in their stored format order as text" },
    { "operator": "<", "value": "09:30", "target": "10:00", "expected": true },
    { "operator": "<", "value": "", "target": "10:00", "expected": false },
    { "operator": "any", "value": "redis", "target": ["redis", "memcached"], "expected": true },
    { "operator": "any", "value": "file", "target": ["redis", "memcached"], "expected": false },
    { "operator": "any", "value": ["x", "memcached"], "target": ["redis", "memcached"], "expected": true, "note": "a list: one of its values is enough" },
    { "operator": "any", "value": [], "target": ["redis"], "expected": false },
    { "operator": "any", "value": 2, "target": ["1", "2"], "expected": true },
    { "operator": "not-any", "value": "file", "target": ["redis", "memcached"], "expected": true },
    { "operator": "not-any", "value": ["redis"], "target": ["redis", "memcached"], "expected": false },
    { "operator": "contains", "value": "https://example.com", "target": "example", "expected": true, "note": "text: inside it" },
    { "operator": "contains", "value": "https://example.com", "target": "acme", "expected": false },
    { "operator": "contains", "value": ["posts", "pages"], "target": "pages", "expected": true, "note": "list: one of its values" },
    { "operator": "contains", "value": ["posts", "pages"], "target": "page", "expected": false },
    { "operator": "contains", "value": 12, "target": "12", "expected": true },
    { "operator": "not-contains", "value": ["posts"], "target": "pages", "expected": true },
    { "operator": "not-contains", "value": "abc", "target": "b", "expected": false },
    { "operator": "empty", "value": "", "target": null, "expected": true },
    { "operator": "empty", "value": null, "target": null, "expected": true },
    { "operator": "empty", "value": [], "target": null, "expected": true },
    { "operator": "empty", "value": false, "target": null, "expected": false, "note": "false and 0 are values" },
    { "operator": "empty", "value": 0, "target": null, "expected": false },
    { "operator": "not-empty", "value": "x", "target": null, "expected": true },
    { "operator": "not-empty", "value": [], "target": null, "expected": false }
  ]
}
