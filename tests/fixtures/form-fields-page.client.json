{
    "id": "fields",
    "title": "Content",
    "description": "How your content is described, shown and indexed.",
    "icon": "document-text",
    "group": "",
    "save": "global",
    "tabs": [],
    "sections": [
        {
            "id": "seo",
            "tab": "",
            "title": "SEO",
            "description": "How your content appears in search results.",
            "tone": "default",
            "fields": [
                {
                    "id": "meta_description",
                    "type": "textarea",
                    "label": "Default meta description",
                    "description": "Used as the default meta description.",
                    "default": "Fyldo is a lightweight settings framework.",
                    "disabled": false,
                    "layout": "stacked",
                    "validate": {
                        "max_length": 160
                    },
                    "placeholder": "Describe your site in a sentence or two…",
                    "rows": 4,
                    "resize": "vertical"
                },
                {
                    "id": "post_types",
                    "type": "checkbox_group",
                    "label": "Show on",
                    "description": "Post types where this block is displayed.",
                    "default": [
                        "post",
                        "page"
                    ],
                    "disabled": false,
                    "layout": "stacked",
                    "validate": {
                        "min": 1,
                        "allowed": [
                            "post",
                            "page"
                        ]
                    },
                    "parent": "All post types",
                    "options": [
                        {
                            "value": "post",
                            "label": "Posts",
                            "disabled": false
                        },
                        {
                            "value": "page",
                            "label": "Pages",
                            "disabled": false
                        },
                        {
                            "value": "product",
                            "label": "Products",
                            "disabled": true,
                            "description": "Available in Pro."
                        }
                    ]
                },
                {
                    "id": "sitemap_types",
                    "type": "multi_select",
                    "label": "Include in sitemap",
                    "description": "Content types listed in the XML sitemap.",
                    "default": [
                        "post",
                        "page"
                    ],
                    "disabled": false,
                    "layout": "stacked",
                    "validate": {
                        "min": 1,
                        "max": 5,
                        "allowed": [
                            "post",
                            "page",
                            "product",
                            "author",
                            "category",
                            "tag",
                            "media"
                        ]
                    },
                    "placeholder": "Select content types…",
                    "searchable": true,
                    "clearable": true,
                    "options": [
                        {
                            "value": "post",
                            "label": "Posts",
                            "disabled": false
                        },
                        {
                            "value": "page",
                            "label": "Pages",
                            "disabled": false
                        },
                        {
                            "value": "product",
                            "label": "Products",
                            "disabled": false
                        },
                        {
                            "value": "author",
                            "label": "Authors",
                            "disabled": false
                        },
                        {
                            "value": "category",
                            "label": "Categories",
                            "disabled": false
                        },
                        {
                            "value": "tag",
                            "label": "Tags",
                            "disabled": false
                        },
                        {
                            "value": "media",
                            "label": "Media",
                            "disabled": false
                        },
                        {
                            "value": "comment",
                            "label": "Comments",
                            "disabled": true
                        }
                    ]
                },
                {
                    "id": "layout",
                    "type": "radio",
                    "label": "Layout",
                    "description": "How content is laid out on the page.",
                    "default": "full",
                    "disabled": false,
                    "layout": "stacked",
                    "validate": {
                        "required": true,
                        "allowed": [
                            "full",
                            "boxed"
                        ]
                    },
                    "options": [
                        {
                            "value": "full",
                            "label": "Full width",
                            "disabled": false,
                            "description": "Content spans the entire screen."
                        },
                        {
                            "value": "boxed",
                            "label": "Boxed",
                            "disabled": false,
                            "description": "Content sits in a centered 1200px column."
                        }
                    ]
                },
                {
                    "id": "agree",
                    "type": "checkbox",
                    "label": "I agree to the terms",
                    "description": "You must accept the terms to continue.",
                    "default": false,
                    "disabled": false,
                    "layout": "inline",
                    "validate": {}
                }
            ]
        },
        {
            "id": "connection",
            "tab": "",
            "title": "Connection",
            "description": "How this site talks to the outside world.",
            "tone": "default",
            "fields": [
                {
                    "id": "connection_note",
                    "type": "notice",
                    "label": "Before you connect",
                    "description": "Keys are stored in the database and are never shown again.",
                    "tone": "blue"
                },
                {
                    "id": "canonical_base",
                    "type": "url",
                    "label": "Canonical URL",
                    "description": "The address search engines should use.",
                    "default": "",
                    "disabled": false,
                    "layout": "stacked",
                    "validate": {
                        "schemes": [
                            "https"
                        ]
                    },
                    "placeholder": "https://example.com"
                },
                {
                    "id": "contact_email",
                    "type": "email",
                    "label": "Contact email",
                    "description": "",
                    "default": "",
                    "disabled": false,
                    "layout": "stacked",
                    "validate": {
                        "email": true
                    },
                    "placeholder": "name@example.com"
                },
                {
                    "id": "api_key",
                    "type": "password",
                    "label": "API key",
                    "description": "Paste the key from your provider.",
                    "default": "",
                    "disabled": false,
                    "layout": "stacked",
                    "validate": {
                        "min_length": 8
                    },
                    "placeholder": "",
                    "autocomplete": "new-password"
                },
                {
                    "id": "per_page",
                    "type": "number",
                    "label": "Items per page",
                    "description": "Between 5 and 100, in steps of 5.",
                    "default": 10,
                    "disabled": false,
                    "layout": "stacked",
                    "validate": {
                        "min": 5,
                        "max": 100,
                        "step": 5,
                        "number": true
                    },
                    "placeholder": ""
                },
                {
                    "id": "license_key",
                    "type": "text",
                    "label": "License key",
                    "description": "",
                    "default": "FYLDO-FREE",
                    "disabled": "Managed by your hosting provider.",
                    "layout": "stacked",
                    "validate": {},
                    "placeholder": ""
                }
            ]
        }
    ],
    "values": {
        "meta_description": "Fyldo is a lightweight settings framework.",
        "post_types": [
            "post",
            "page"
        ],
        "sitemap_types": [
            "post",
            "page"
        ],
        "layout": "full",
        "agree": false,
        "canonical_base": "",
        "contact_email": "",
        "api_key": "",
        "per_page": 10,
        "license_key": "FYLDO-FREE"
    },
    "revision": "rev-1"
}
