    { "name": "a double hash is not a colour", "input": "##abc", "expect": "##abc" },
    { "name": "null is nothing", "input": null, "expect": "" },
    { "name": "a number is nothing", "input": 123456, "expect": "" },
    { "name": "a boolean is nothing", "input": true, "expect": "" },
    { "name": "a list is nothing", "input": [], "expect": "" }
  ]
