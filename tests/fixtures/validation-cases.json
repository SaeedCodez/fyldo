{
  "$comment": "Shared by PHPUnit (tests/php/Unit/RulesTest.php, DigitsTest.php) and Vitest (tests/js/validation.test.ts, digits.test.ts). `cases`: `expect` is the id of the first failing rule, or null when the value is valid. Rule order: required, min_length, max_length, pattern, schemes, email, number, color, allowed, min, max, step. For a list value (checkbox group, multi select) min/max count the selected items and an empty list still counts against min. A number field's value is int|float, or text that could not be read as a number (the implied `number` rule fails it); `step` counts from `min` (0 when there is none). `digits`: what a field of that type keeps of a typed/pasted text once Persian (U+06F0-9) and Arabic-Indic (U+0660-9) digits are read as ASCII, the Arabic decimal separator (U+066B) as \".\" and the Arabic thousands separator (U+066C) is removed: only url, email and number do it (text and password are never touched). `numbers`: what a number field makes of any raw value (`sanitizeNumber` in TS, `NumberField::read` in PHP). `colors`: what a color field makes of any raw value (`sanitizeColor` in TS, `ColorField::read` in PHP): a colour in any accepted spelling (`#rgb`, `#rrggbb`, with or without the `#`, any case, surrounding space) becomes `#rrggbb` in lower case; other text is kept trimmed so the `color` rule can report it; a value that is not text is nothing. Callbacks (`validate_cb`, `sanitize_cb`) are PHP callables and cannot run in the browser; they are covered by PHPUnit only.",
  "cases": [
    { "name": "required: empty string fails", "rules": { "required": true }, "value": "", "expect": "required" },
    { "name": "required: null fails", "rules": { "required": true }, "value": null, "expect": "required" },
    { "name": "required: empty array fails", "rules": { "required": true }, "value": [], "expect": "required" },
    { "name": "required: false is a value", "rules": { "required": true }, "value": false, "expect": null },
    { "name": "required: zero is a value", "rules": { "required": true }, "value": 0, "expect": null },
    { "name": "required: string '0' is a value", "rules": { "required": true }, "value": "0", "expect": null },
    { "name": "required: text passes", "rules": { "required": true }, "value": "Fyldo", "expect": null },
    { "name": "optional: empty skips every other rule", "rules": { "min_length": 5, "pattern": "^x$", "email": true }, "value": "", "expect": null },

    { "name": "min_length: too short", "rules": { "min_length": 3 }, "value": "ab", "expect": "min_length" },
    { "name": "min_length: exact", "rules": { "min_length": 3 }, "value": "abc", "expect": null },
    { "name": "max_length: too long", "rules": { "max_length": 3 }, "value": "abcd", "expect": "max_length" },
    { "name": "max_length: exact", "rules": { "max_length": 3 }, "value": "abc", "expect": null },
    { "name": "max_length: counts code points, not bytes (Persian)", "rules": { "max_length": 4 }, "value": "سایت", "expect": null },
    { "name": "max_length: Persian one over", "rules": { "max_length": 3 }, "value": "سایت", "expect": "max_length" },
    { "name": "max_length: emoji is one character", "rules": { "max_length": 1 }, "value": "🙂", "expect": null },
    { "name": "max_length: accented letters", "rules": { "max_length": 4 }, "value": "café", "expect": null },
    { "name": "min_length is checked before max_length", "rules": { "min_length": 5, "max_length": 2 }, "value": "abc", "expect": "min_length" },

    { "name": "pattern: matches", "rules": { "pattern": "^[a-z]+$" }, "value": "abc", "expect": null },
    { "name": "pattern: does not match", "rules": { "pattern": "^[a-z]+$" }, "value": "abc1", "expect": "pattern" },
    { "name": "pattern: unanchored search semantics", "rules": { "pattern": "b+" }, "value": "abbbc", "expect": null },
    { "name": "pattern: unicode aware", "rules": { "pattern": "^\\p{L}+$" }, "value": "سایت", "expect": null },

    { "name": "schemes: https allowed", "rules": { "schemes": ["http", "https"] }, "value": "https://example.com/path?q=1", "expect": null },
    { "name": "schemes: http allowed", "rules": { "schemes": ["http", "https"] }, "value": "http://example.com", "expect": null },
    { "name": "schemes: ftp rejected", "rules": { "schemes": ["http", "https"] }, "value": "ftp://example.com", "expect": "schemes" },
    { "name": "schemes: javascript rejected", "rules": { "schemes": ["http", "https"] }, "value": "javascript:alert(1)", "expect": "schemes" },
    { "name": "schemes: missing scheme rejected", "rules": { "schemes": ["http", "https"] }, "value": "example.com", "expect": "schemes" },
    { "name": "schemes: only https", "rules": { "schemes": ["https"] }, "value": "http://example.com", "expect": "schemes" },
    { "name": "schemes: scheme is case-insensitive", "rules": { "schemes": ["https"] }, "value": "HTTPS://example.com", "expect": null },
    { "name": "schemes: host required", "rules": { "schemes": ["https"] }, "value": "https://", "expect": "schemes" },

    { "name": "email: plain address", "rules": { "email": true }, "value": "hello@example.com", "expect": null },
    { "name": "email: plus addressing", "rules": { "email": true }, "value": "hello+tag@example.co.uk", "expect": null },
    { "name": "email: missing at", "rules": { "email": true }, "value": "hello.example.com", "expect": "email" },
    { "name": "email: no dot in domain", "rules": { "email": true }, "value": "hello@localhost", "expect": "email" },
    { "name": "email: space inside", "rules": { "email": true }, "value": "hel lo@example.com", "expect": "email" },
    { "name": "email: double dot in local part", "rules": { "email": true }, "value": "a..b@example.com", "expect": "email" },
    { "name": "email: trailing dot in local part", "rules": { "email": true }, "value": "a.@example.com", "expect": "email" },

    { "name": "allowed: member", "rules": { "allowed": ["en_US", "fa_IR"] }, "value": "fa_IR", "expect": null },
    { "name": "allowed: non member", "rules": { "allowed": ["en_US", "fa_IR"] }, "value": "de_DE", "expect": "allowed" },
    { "name": "allowed: compares as strings", "rules": { "allowed": ["1", "2"] }, "value": "2", "expect": null },
    { "name": "allowed: multi value all members", "rules": { "allowed": ["a", "b", "c"] }, "value": ["a", "c"], "expect": null },
    { "name": "allowed: multi value with a stranger", "rules": { "allowed": ["a", "b", "c"] }, "value": ["a", "z"], "expect": "allowed" },

    { "name": "min: below", "rules": { "min": 5 }, "value": 4, "expect": "min" },
    { "name": "min: equal", "rules": { "min": 5 }, "value": 5, "expect": null },
    { "name": "max: above", "rules": { "max": 5 }, "value": 6, "expect": "max" },
    { "name": "max: equal", "rules": { "max": 5 }, "value": 5, "expect": null },
    { "name": "min/max: float inside", "rules": { "min": 0, "max": 1 }, "value": 0.5, "expect": null },

    { "name": "textarea: a line break is one character", "rules": { "max_length": 3 }, "value": "a\nb", "expect": null },
    { "name": "textarea: one over with line breaks", "rules": { "max_length": 3 }, "value": "a\nbc", "expect": "max_length" },
    { "name": "textarea: Persian multi-line counts code points", "rules": { "max_length": 11 }, "value": "سایت\nمن\nاست", "expect": null },
    { "name": "textarea: Persian multi-line one over", "rules": { "max_length": 10 }, "value": "سایت\nمن\nاست", "expect": "max_length" },
    { "name": "textarea: over the limit is an error, never truncated (172/160)", "rules": { "max_length": 160 }, "value": "xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx", "expect": "max_length" },
    { "name": "textarea: exactly at the limit (160/160)", "rules": { "max_length": 160 }, "value": "xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx", "expect": null },
    { "name": "textarea: whitespace-only counts as text", "rules": { "required": true }, "value": "   ", "expect": null },

    { "name": "radio: always required, empty fails", "rules": { "required": true, "allowed": ["index", "noindex"] }, "value": "", "expect": "required" },
    { "name": "radio: member", "rules": { "required": true, "allowed": ["index", "noindex"] }, "value": "noindex", "expect": null },
    { "name": "radio: stranger", "rules": { "required": true, "allowed": ["index", "noindex"] }, "value": "follow", "expect": "allowed" },

    { "name": "list: required, empty list fails", "rules": { "required": true }, "value": [], "expect": "required" },
    { "name": "list: optional empty list passes", "rules": { "allowed": ["a", "b"] }, "value": [], "expect": null },
    { "name": "list min: empty list fails min 1", "rules": { "min": 1 }, "value": [], "expect": "min" },
    { "name": "list min: below", "rules": { "min": 2 }, "value": ["a"], "expect": "min" },
    { "name": "list min: exact", "rules": { "min": 2 }, "value": ["a", "b"], "expect": null },
    { "name": "list max: above", "rules": { "max": 2 }, "value": ["a", "b", "c"], "expect": "max" },
    { "name": "list max: exact", "rules": { "max": 2 }, "value": ["a", "b"], "expect": null },
    { "name": "list: allowed is checked before min", "rules": { "allowed": ["a", "b"], "min": 3 }, "value": ["z"], "expect": "allowed" },
    { "name": "list: min is checked before max", "rules": { "min": 3, "max": 1 }, "value": ["a", "b"], "expect": "min" },
    { "name": "list: numeric-looking values compare as strings", "rules": { "allowed": ["1", "2"], "min": 1 }, "value": ["2"], "expect": null },
    { "name": "list: required + min + allowed pass together", "rules": { "required": true, "min": 1, "max": 2, "allowed": ["a", "b", "c"] }, "value": ["a", "c"], "expect": null },

    { "name": "multi select: nothing selected passes when optional", "rules": { "allowed": ["post", "page", "product"], "max": 2 }, "value": [], "expect": null },
    { "name": "multi select: required and empty fails before min", "rules": { "required": true, "min": 2, "allowed": ["post", "page", "product"] }, "value": [], "expect": "required" },
    { "name": "multi select: min 2 with one selected", "rules": { "required": true, "min": 2, "allowed": ["post", "page", "product"] }, "value": ["post"], "expect": "min" },
    { "name": "multi select: min 0 accepts an empty list", "rules": { "min": 0 }, "value": [], "expect": null },
    { "name": "multi select: max 0 rejects any selection", "rules": { "max": 0 }, "value": ["post"], "expect": "max" },
    { "name": "multi select: exactly at max", "rules": { "max": 3, "allowed": ["a", "b", "c", "d"] }, "value": ["a", "b", "c"], "expect": null },
    { "name": "multi select: one over max", "rules": { "max": 3, "allowed": ["a", "b", "c", "d"] }, "value": ["a", "b", "c", "d"], "expect": "max" },
    { "name": "multi select: min and max window", "rules": { "min": 2, "max": 3, "allowed": ["a", "b", "c", "d"] }, "value": ["b", "d"], "expect": null },
    { "name": "multi select: a stranger among valid values", "rules": { "min": 1, "allowed": ["a", "b"] }, "value": ["a", "b", "c"], "expect": "allowed" },
    { "name": "multi select: values are case-sensitive", "rules": { "allowed": ["post", "page"] }, "value": ["Post"], "expect": "allowed" },
    { "name": "multi select: a nested value is not an option", "rules": { "allowed": ["a", "b"] }, "value": [["a"]], "expect": "allowed" },
    { "name": "multi select: Persian option values", "rules": { "allowed": ["نوشته", "برگه", "محصول"], "min": 1 }, "value": ["برگه", "محصول"], "expect": null },
    { "name": "multi select: Persian stranger", "rules": { "allowed": ["نوشته", "برگه"] }, "value": ["برگه", "محصول"], "expect": "allowed" },

    { "name": "number: an int passes", "rules": { "number": true }, "value": 12, "expect": null },
    { "name": "number: zero passes", "rules": { "number": true }, "value": 0, "expect": null },
    { "name": "number: a float passes", "rules": { "number": true }, "value": -0.5, "expect": null },
    { "name": "number: empty is optional", "rules": { "number": true }, "value": "", "expect": null },
    { "name": "number: unreadable text fails", "rules": { "number": true }, "value": "abc", "expect": "number" },
    { "name": "number: a decimal comma is not a number", "rules": { "number": true }, "value": "1,5", "expect": "number" },
    { "name": "number: required and empty fails before number", "rules": { "required": true, "number": true }, "value": "", "expect": "required" },
    { "name": "number: zero satisfies required", "rules": { "required": true, "number": true }, "value": 0, "expect": null },
    { "name": "number: is checked before min", "rules": { "number": true, "min": 0 }, "value": "x", "expect": "number" },
    { "name": "min: float bound, equal", "rules": { "min": 1.5 }, "value": 1.5, "expect": null },
    { "name": "min: negative bound", "rules": { "min": -10 }, "value": -11, "expect": "min" },
    { "name": "max: float above", "rules": { "min": 0, "max": 100 }, "value": 100.5, "expect": "max" },
    { "name": "min: float below", "rules": { "min": 0, "max": 100 }, "value": -0.1, "expect": "min" },
    { "name": "step: on the grid", "rules": { "step": 5 }, "value": 10, "expect": null },
    { "name": "step: off the grid", "rules": { "step": 5 }, "value": 11, "expect": "step" },
    { "name": "step: zero is on every grid", "rules": { "step": 3 }, "value": 0, "expect": null },
    { "name": "step: negative values", "rules": { "step": 5 }, "value": -10, "expect": null },
    { "name": "step: negative off the grid", "rules": { "step": 5 }, "value": -11, "expect": "step" },
    { "name": "step: counts from min", "rules": { "min": 1, "step": 5 }, "value": 6, "expect": null },
    { "name": "step: counts from min, zero-based value is off", "rules": { "min": 1, "step": 5 }, "value": 5, "expect": "step" },
    { "name": "step: negative min", "rules": { "min": -3, "step": 2 }, "value": -1, "expect": null },
    { "name": "step: decimal step, float noise (0.3 on 0.1)", "rules": { "step": 0.1 }, "value": 0.3, "expect": null },
    { "name": "step: decimal step, float noise (1.15 on 0.05)", "rules": { "step": 0.05 }, "value": 1.15, "expect": null },
    { "name": "step: decimal step, off the grid", "rules": { "step": 0.1 }, "value": 0.35, "expect": "step" },
    { "name": "step: 1 rejects a fraction", "rules": { "step": 1 }, "value": 1.5, "expect": "step" },
    { "name": "step: half steps", "rules": { "step": 0.5 }, "value": 1.5, "expect": null },
    { "name": "step: min and max come first", "rules": { "min": 0, "max": 10, "step": 5 }, "value": 12, "expect": "max" },
    { "name": "step: max before step, min before max", "rules": { "min": 5, "max": 10, "step": 5 }, "value": 3, "expect": "min" },
    { "name": "number: all four together, on the grid", "rules": { "number": true, "min": 1, "max": 10, "step": 3 }, "value": 7, "expect": null },
    { "name": "number: all four together, top of the grid", "rules": { "number": true, "min": 1, "max": 10, "step": 3 }, "value": 10, "expect": null },
    { "name": "number: all four together, off the grid", "rules": { "number": true, "min": 1, "max": 10, "step": 3 }, "value": 5, "expect": "step" },
    { "name": "step: an empty optional number is not checked", "rules": { "step": 5 }, "value": "", "expect": null },

    { "name": "slider: the rules a slider exports, value at min", "rules": { "required": true, "number": true, "min": 0, "max": 100, "step": 5 }, "value": 0, "expect": null },
    { "name": "slider: value at max", "rules": { "required": true, "number": true, "min": 0, "max": 100, "step": 5 }, "value": 100, "expect": null },
    { "name": "slider: below min is rejected, not clamped", "rules": { "required": true, "number": true, "min": 0, "max": 100, "step": 5 }, "value": -5, "expect": "min" },
    { "name": "slider: above max is rejected, not clamped", "rules": { "required": true, "number": true, "min": 0, "max": 100, "step": 5 }, "value": 105, "expect": "max" },
    { "name": "slider: off the step grid", "rules": { "required": true, "number": true, "min": 0, "max": 100, "step": 5 }, "value": 33, "expect": "step" },
    { "name": "slider: nothing is never valid (a slider always has a value)", "rules": { "required": true, "number": true, "min": 0, "max": 100, "step": 5 }, "value": "", "expect": "required" },
    { "name": "slider: text that is not a number", "rules": { "required": true, "number": true, "min": 0, "max": 100, "step": 5 }, "value": "abc", "expect": "number" },
    { "name": "slider: the grid starts at min (10, 25, 40)", "rules": { "required": true, "number": true, "min": 10, "max": 50, "step": 15 }, "value": 25, "expect": null },
    { "name": "slider: the grid starts at min (30 is off it)", "rules": { "required": true, "number": true, "min": 10, "max": 50, "step": 15 }, "value": 30, "expect": "step" },
    { "name": "slider: decimal step (0.3 on a 0.1 grid)", "rules": { "required": true, "number": true, "min": 0, "max": 1, "step": 0.1 }, "value": 0.3, "expect": null },
    { "name": "slider: decimal step, off the grid", "rules": { "required": true, "number": true, "min": 0, "max": 1, "step": 0.1 }, "value": 0.35, "expect": "step" },

    { "name": "segmented: an enabled option", "rules": { "required": true, "allowed": ["order", "product", "simple"] }, "value": "product", "expect": null },
    { "name": "segmented: not one of the options", "rules": { "required": true, "allowed": ["order", "product", "simple"] }, "value": "other", "expect": "allowed" },
    { "name": "segmented: never empty", "rules": { "required": true, "allowed": ["order", "product", "simple"] }, "value": "", "expect": "required" },

    { "name": "color: a stored colour passes", "rules": { "color": true }, "value": "#2271b1", "expect": null },
    { "name": "color: short hex is not the stored form", "rules": { "color": true }, "value": "#abc", "expect": "color" },
    { "name": "color: upper case is not the stored form", "rules": { "color": true }, "value": "#2271B1", "expect": "color" },
    { "name": "color: a name is not a colour", "rules": { "color": true }, "value": "red", "expect": "color" },
    { "name": "color: five digits", "rules": { "color": true }, "value": "#12345", "expect": "color" },
    { "name": "color: seven digits", "rules": { "color": true }, "value": "#1234567", "expect": "color" },
    { "name": "color: not hex digits", "rules": { "color": true }, "value": "#gggggg", "expect": "color" },
    { "name": "color: the hash is required", "rules": { "color": true }, "value": "2271b1", "expect": "color" },
    { "name": "color: alpha is not supported", "rules": { "color": true }, "value": "#2271b1ff", "expect": "color" },
    { "name": "color: empty is optional", "rules": { "color": true }, "value": "", "expect": null },
    { "name": "color: required and empty fails before color", "rules": { "required": true, "color": true }, "value": "", "expect": "required" },
    { "name": "color: required and valid passes", "rules": { "required": true, "color": true }, "value": "#000000", "expect": null },

    { "name": "choice: an enabled option", "rules": { "required": true, "allowed": ["light", "dark", "system"] }, "value": "dark", "expect": null },
    { "name": "choice: nothing selected is the required error", "rules": { "required": true, "allowed": ["light", "dark", "system"] }, "value": "", "expect": "required" },
    { "name": "choice: not one of the options", "rules": { "required": true, "allowed": ["light", "dark", "system"] }, "value": "contrast", "expect": "allowed" },
    { "name": "choice: a disabled option is not in allowed, so it cannot be chosen", "rules": { "required": true, "allowed": ["light", "dark"] }, "value": "system", "expect": "allowed" },

    { "name": "combination: first failing rule wins", "rules": { "required": true, "min_length": 3, "pattern": "^[a-z]+$" }, "value": "A1", "expect": "min_length" },
    { "name": "combination: pattern after length", "rules": { "required": true, "min_length": 2, "pattern": "^[a-z]+$" }, "value": "A1", "expect": "pattern" }
  ],

  "digits": [
    { "name": "text keeps Persian digits", "type": "text", "input": "سایت ۱۲۳", "expect": "سایت ۱۲۳" },
    { "name": "text keeps Arabic-Indic digits", "type": "text", "input": "٤٥٦", "expect": "٤٥٦" },
    { "name": "password is never touched", "type": "password", "input": "pass۱۲٣word", "expect": "pass۱۲٣word" },
    { "name": "url: Persian digits in the path", "type": "url", "input": "https://example.com/page/۱۲۳", "expect": "https://example.com/page/123" },
    { "name": "url: Persian digits in host and port", "type": "url", "input": "https://۱۲۳.example.com:۸۰۸۰/a", "expect": "https://123.example.com:8080/a" },
    { "name": "url: Arabic-Indic digits in the query", "type": "url", "input": "https://example.com/?page=٤٢", "expect": "https://example.com/?page=42" },
    { "name": "url: ASCII is untouched", "type": "url", "input": "https://example.com/a-1", "expect": "https://example.com/a-1" },
    { "name": "email: Persian digits in the local part", "type": "email", "input": "user۱۲@example.com", "expect": "user12@example.com" },
    { "name": "email: Arabic-Indic digits in the domain", "type": "email", "input": "user@example٢.com", "expect": "user@example2.com" },
    { "name": "email: all ten of each script", "type": "email", "input": "a۰۱۲۳۴۵۶۷۸۹٠١٢٣٤٥٦٧٨٩@example.com", "expect": "a01234567890123456789@example.com" },
    { "name": "url: Persian separators are read too", "type": "url", "input": "https://example٫com/page/۱٬۰۰۰", "expect": "https://example.com/page/1000" },
    { "name": "email: Persian decimal separator in the domain", "type": "email", "input": "user@example٫com", "expect": "user@example.com" },
    { "name": "text keeps the Persian separators", "type": "text", "input": "۱٬۲۳۴٫۵", "expect": "۱٬۲۳۴٫۵" },
    { "name": "password keeps the Persian separators", "type": "password", "input": "a٫b٬c", "expect": "a٫b٬c" }
  ],

  "numbers": [
    { "name": "ASCII integer", "input": "42", "expect": 42 },
    { "name": "Persian digits", "input": "۴۲", "expect": 42 },
    { "name": "Arabic-Indic digits", "input": "٤٢", "expect": 42 },
    { "name": "both scripts mixed with ASCII", "input": "۱٢3", "expect": 123 },
    { "name": "decimal", "input": "3.14", "expect": 3.14 },
    { "name": "Persian digits around a dot", "input": "۳.۱۴", "expect": 3.14 },
    { "name": "surrounding spaces are ignored", "input": "  7 ", "expect": 7 },
    { "name": "trailing line break is ignored", "input": "7\n", "expect": 7 },
    { "name": "empty is nothing", "input": "", "expect": "" },
    { "name": "blank is nothing", "input": "   ", "expect": "" },
    { "name": "negative", "input": "-5", "expect": -5 },
    { "name": "explicit plus", "input": "+5", "expect": 5 },
    { "name": "leading dot", "input": ".5", "expect": 0.5 },
    { "name": "trailing dot", "input": "5.", "expect": 5 },
    { "name": "5.0 stores as the whole number 5", "input": "5.0", "expect": 5 },
    { "name": "negative zero is zero", "input": "-0", "expect": 0 },
    { "name": "leading zeros", "input": "00012", "expect": 12 },
    { "name": "0.1", "input": "0.1", "expect": 0.1 },
    { "name": "a very large number stays a float", "input": "99999999999999999999", "expect": 1e20 },
    { "name": "letters are not a number", "input": "abc", "expect": "abc" },
    { "name": "digits then letters", "input": "۱۲abc", "expect": "12abc" },
    { "name": "a thousands comma is not a number", "input": "1,000", "expect": "1,000" },
    { "name": "an exponent is not a number", "input": "1e3", "expect": "1e3" },
    { "name": "a lone minus is not a number yet", "input": "-", "expect": "-" },
    { "name": "the Persian decimal separator reads as a dot", "input": "۱٫۵", "expect": 1.5 },
    { "name": "the Persian thousands separator is dropped", "input": "۱۲٬۳۴۵", "expect": 12345 },
    { "name": "both Persian separators", "input": "۱٬۲۳۴٫۵۶", "expect": 1234.56 },
    { "name": "a leading Persian decimal separator", "input": "٫۵", "expect": 0.5 },
    { "name": "negative with both Persian separators", "input": "-۱٬۲۳۴٫۵", "expect": -1234.5 },
    { "name": "the Persian decimal separator with ASCII digits", "input": "3٫14", "expect": 3.14 },
    { "name": "two Persian decimal separators are not a number", "input": "۱٫۲٫۳", "expect": "1.2.3" },
    { "name": "a lone Persian thousands separator is nothing", "input": "٬", "expect": "" },
    { "name": "a JSON integer", "input": 7, "expect": 7 },
    { "name": "a JSON float", "input": 2.5, "expect": 2.5 },
    { "name": "a whole float becomes an int", "input": 4.0, "expect": 4 },
    { "name": "null is nothing", "input": null, "expect": "" },
    { "name": "a boolean is nothing", "input": true, "expect": "" },
    { "name": "a list is nothing", "input": [], "expect": "" }
  ],
  "colors": [
    { "name": "a stored colour stays as it is", "input": "#2271b1", "expect": "#2271b1" },
    { "name": "upper case is lowered", "input": "#2271B1", "expect": "#2271b1" },
    { "name": "short hex is expanded", "input": "#abc", "expect": "#aabbcc" },
    { "name": "short hex in upper case", "input": "#F0A", "expect": "#ff00aa" },
    { "name": "the hash is optional", "input": "2271b1", "expect": "#2271b1" },
    { "name": "short hex without a hash", "input": "abc", "expect": "#aabbcc" },
    { "name": "surrounding spaces are ignored", "input": "  #2271B1 ", "expect": "#2271b1" },
    { "name": "a trailing line break is ignored", "input": "#2271b1\n", "expect": "#2271b1" },
    { "name": "empty is nothing", "input": "", "expect": "" },
    { "name": "blank is nothing", "input": "   ", "expect": "" },
    { "name": "four digits are not a colour (no alpha)", "input": "#abcd", "expect": "#abcd" },
    { "name": "eight digits are not a colour (no alpha)", "input": "#2271b1ff", "expect": "#2271b1ff" },
    { "name": "five digits are not a colour", "input": "#12345", "expect": "#12345" },
    { "name": "not hex digits", "input": "#ggg", "expect": "#ggg" },
