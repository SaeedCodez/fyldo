{
  // The sample modules see only assets/dist/fyldo-sdk.d.ts and @types/react, as a plugin or theme does (npm run types).
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": false,
    "types": [],
    "paths": { "fyldo": ["../../assets/dist/fyldo-sdk.d.ts"] }
  },
  "include": ["*.tsx"]
}
