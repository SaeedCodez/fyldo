{
  "name": "fyldo",
  "version": "0.0.0-dev",
  "private": true,
  "description": "Fyldo \u2014 settings-page framework for WordPress plugin developers (development workspace; consumers never need Node).",
  "license": "GPL-2.0-or-later",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite build --watch",
    "build": "npm run tokens && npm run icons && vite build",
    "tokens": "tsx tools/tokens/build.ts",
    "tokens:check": "tsx tools/tokens/build.ts --check",
    "icons": "tsx tools/icons/build.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint app tools tests/js e2e --max-warnings 0",
    "format": "prettier --write \"app/**/*.{ts,tsx,css}\" \"tools/**/*.ts\" \"tests/js/**/*.ts\" \"e2e/**/*.ts\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "env:start": "wp-env start",
    "env:stop": "wp-env stop",
    "env:clean": "wp-env clean all",
    "size": "size-limit",
    "tokens:snapshot": "tsx tools/tokens/snapshot.ts",
    "i18n:pot": "tsx tools/i18n/pot.ts",
    "i18n:compile": "tsx tools/i18n/compile.ts",
    "i18n": "npm run i18n:pot && npm run i18n:compile"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@base-ui/react": "^1.8.0",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@fontsource-variable/vazirmatn": "^5.3.0",
    "@playwright/test": "^1.63.0",
    "@size-limit/file": "^14.1.0",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^24.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitest/browser-playwright": "^5.0.2",
    "@wordpress/env": "^11.16.0",
    "@wordpress/i18n": "^6.29.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "eslint": "^9.39.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "gettext-parser": "^1.4.0",
    "globals": "^17.12.0",
    "iconsax-reactjs": "0.0.8",
    "jsdom": "^30.1.1",
    "postcss": "^8.5.28",
    "postcss-selector-parser": "^7.1.6",
    "prettier": "^3.9.9",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "size-limit": "^14.1.0",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "~5.9.0",
    "typescript-eslint": "^8.71.0",
    "vite": "^8.3.1",
    "vitest": "^5.0.2"
  }
}
