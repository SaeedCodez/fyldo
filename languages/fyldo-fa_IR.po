# Persian (Iran) translation of Fyldo.
# Tone: neutral-formal ("شما" is implicit; imperatives use the polite plural form). Reviewed by the project owner.
msgid ""
msgstr ""
"Project-Id-Version: Fyldo 1.0.0-dev\n"
"Report-Msgid-Bugs-To: https://wordpress.org/support/plugin/fyldo\n"
"Last-Translator: \n"
"Language-Team: Persian\n"
"Language: fa_IR\n"
"MIME-Version: 1.0\n"
"Content-Type: text/plain; charset=UTF-8\n"
"Content-Transfer-Encoding: 8bit\n"
"Plural-Forms: nplurals=2; plural=(n > 1);\n"
"X-Domain: fyldo\n"

msgid "Fyldo"
msgstr "فیلدو"

msgid "Settings-page framework for WordPress plugin developers. Declare pages, sections and fields in PHP; get a modern admin UI with REST-backed validation and saving."
msgstr "چارچوب صفحهٔ تنظیمات برای توسعه‌دهندگان افزونهٔ وردپرس. صفحه‌ها، بخش‌ها و فیلدها را در PHP تعریف کنید و یک رابط مدیریتی مدرن با اعتبارسنجی و ذخیره‌سازی از طریق REST دریافت کنید."

msgid "You have unsaved changes"
msgstr "تغییرات ذخیره‌نشده دارید"

msgid "Saving changes…"
msgstr "در حال ذخیره‌ی تغییرات…"

msgid "All changes saved"
msgstr "همه‌ی تغییرات ذخیره شد"

msgid "Couldn't save. Check your connection and try again."
msgstr "ذخیره نشد. اتصال خود را بررسی کنید و دوباره تلاش کنید."

msgid "Unsaved changes"
msgstr "تغییرات ذخیره‌نشده"

msgid "Discard"
msgstr "لغو تغییرات"

msgid "Save changes"
msgstr "ذخیره‌ی تغییرات"

msgid "This settings screen needs JavaScript. Please enable it and reload the page."
msgstr "این صفحهٔ تنظیمات به جاوااسکریپت نیاز دارد. آن را فعال کنید و صفحه را دوباره بارگذاری کنید."

msgid "The values must be an object."
msgstr "مقادیر باید یک شیء باشند."

msgid "Some values are not valid."
msgstr "برخی مقادیر معتبر نیستند."

msgid "These settings were changed somewhere else. Reload to see the latest values."
msgstr "این تنظیمات در جای دیگری تغییر کرده‌اند. برای دیدن آخرین مقادیر، صفحه را دوباره بارگذاری کنید."

msgid "You must be logged in."
msgstr "باید وارد حساب کاربری خود شوید."

msgid "This settings page does not exist."
msgstr "این صفحهٔ تنظیمات وجود ندارد."

msgid "Your session has expired. Reload the page and try again."
msgstr "نشست شما منقضی شده است. صفحه را دوباره بارگذاری کنید و دوباره تلاش کنید."

msgid "You are not allowed to change these settings."
msgstr "اجازهٔ تغییر این تنظیمات را ندارید."

msgid "The request is too large."
msgstr "درخواست بیش از حد بزرگ است."

msgid "This field is required."
msgstr "این فیلد الزامی است."

msgid "Use at least %d character."
msgid_plural "Use at least %d characters."
msgstr[0] "دست‌کم %d نویسه وارد کنید."
msgstr[1] "دست‌کم %d نویسه وارد کنید."

msgid "Use no more than %d character."
msgid_plural "Use no more than %d characters."
msgstr[0] "حداکثر %d نویسه مجاز است."
msgstr[1] "حداکثر %d نویسه مجاز است."

msgid "This value is not in the expected format."
msgstr "قالب این مقدار درست نیست."

msgid "Enter a valid URL."
msgstr "یک نشانی اینترنتی معتبر وارد کنید."

msgid "Enter a valid email address."
msgstr "یک نشانی ایمیل معتبر وارد کنید."

msgid "Enter a number."
msgstr "یک عدد وارد کنید."

msgid "Enter a value in steps of %s."
msgstr "مقدار را با گام %s وارد کنید."

msgid "Choose one of the available options."
msgstr "یکی از گزینه‌های موجود را انتخاب کنید."

msgid "Enter a value of at least %s."
msgstr "مقداری دست‌کم برابر با %s وارد کنید."

msgid "Enter a value of at most %s."
msgstr "مقداری حداکثر برابر با %s وارد کنید."

msgid "This value is not valid."
msgstr "این مقدار معتبر نیست."

msgid "Select at least %d option."
msgid_plural "Select at least %d options."
msgstr[0] "دست‌کم %d گزینه را انتخاب کنید."
msgstr[1] "دست‌کم %d گزینه را انتخاب کنید."

msgid "Select no more than %d option."
msgid_plural "Select no more than %d options."
msgstr[0] "حداکثر %d گزینه را می‌توانید انتخاب کنید."
msgstr[1] "حداکثر %d گزینه را می‌توانید انتخاب کنید."

msgid "%d character remaining."
msgid_plural "%d characters remaining."
msgstr[0] "%d نویسه باقی مانده است."
msgstr[1] "%d نویسه باقی مانده است."

msgid "%d character over the limit."
msgid_plural "%d characters over the limit."
msgstr[0] "%d نویسه بیشتر از حد مجاز است."
msgstr[1] "%d نویسه بیشتر از حد مجاز است."

msgid "Remove %s"
msgstr "حذف %s"

msgid "%s removed"
msgstr "%s حذف شد"

msgid "Selection cleared"
msgstr "انتخاب‌ها پاک شد"

msgid "Clear all"
msgstr "پاک کردن همه"

msgid "Search…"
msgstr "جستجو…"

msgid "Search options"
msgstr "جستجوی گزینه‌ها"

msgid "No results found."
msgstr "نتیجه‌ای پیدا نشد."

msgid "%s selected"
msgid_plural "%s selected"
msgstr[0] "%s مورد انتخاب شده"
msgstr[1] "%s مورد انتخاب شده"

msgid "%s more selected"
msgid_plural "%s more selected"
msgstr[0] "%s مورد دیگر انتخاب شده"
msgstr[1] "%s مورد دیگر انتخاب شده"

msgid "Note"
msgstr "یادداشت"

msgid "Information"
msgstr "اطلاعات"

msgid "Success"
msgstr "موفقیت"

msgid "Warning"
msgstr "هشدار"

msgid "Error"
msgstr "خطا"

msgid "•••• set"
msgstr "•••• تنظیم شده"

msgid "A value is already saved. Leave this empty to keep it, or type a new one to replace it."
msgstr "مقداری از قبل ذخیره شده است. برای نگه داشتن آن این فیلد را خالی بگذارید، یا برای جایگزینی مقدار جدیدی وارد کنید."

#. translators: %s: version number of the plugin, e.g. 1.0
msgctxt "version badge"
msgid "v%s"
msgstr "%s"

msgid "(opens in a new tab)"
msgstr "(در زبانه‌ی تازه باز می‌شود)"

msgid "Resources"
msgstr "منابع"

msgid "Menu"
msgstr "منو"

# M3 part 2: save patterns, the unsaved-changes dialog, conflicts. Texts drawn in the pack follow the pack
# (design/figma/components/save-bar.json, modal.json, section-card.json).
msgid "Couldn’t save. Check the highlighted fields."
msgstr "ذخیره نشد. فیلدهای مشخص‌شده را بررسی کنید."

msgid "Save"
msgstr "ذخیره"

msgid "Changes take effect after you save."
msgstr "تغییرات پس از ذخیره اعمال می‌شوند."

msgid "Discard unsaved changes?"
msgstr "تغییرات ذخیره‌نشده حذف شوند؟"

msgid "Your edits on this page haven’t been saved and will be lost."
msgstr "ویرایش‌های این صفحه ذخیره نشده‌اند و از بین می‌روند."

msgid "Keep editing"
msgstr "ادامه‌ی ویرایش"

msgctxt "unsaved changes dialog"
msgid "Discard"
msgstr "حذف تغییرات"

msgid "Close"
msgstr "بستن"

msgid "These settings were changed somewhere else"
msgstr "این تنظیمات در جای دیگری تغییر کرده‌اند"

msgid "They were saved in another tab or by another person after this page was opened, so your changes were not saved. Reload the latest values to continue; your unsaved changes on this page will be lost."
msgstr "این تنظیمات پس از باز شدن این صفحه در زبانه‌ی دیگری یا توسط شخص دیگری ذخیره شده‌اند، بنابراین تغییرات شما ذخیره نشد. برای ادامه، آخرین مقادیر را بارگذاری کنید؛ تغییرات ذخیره‌نشده‌ی شما در این صفحه از بین می‌روند."

msgid "Reload latest values"
msgstr "بارگذاری آخرین مقادیر"

msgid "Couldn’t save: these settings were changed somewhere else."
msgstr "ذخیره نشد: این تنظیمات در جای دیگری تغییر کرده‌اند."

msgid "Couldn’t load the latest values. Check your connection and try again."
msgstr "بارگذاری آخرین مقادیر انجام نشد. اتصال خود را بررسی کنید و دوباره تلاش کنید."

# Code-only design (docs/design-spec.md): the password show/hide toggle.
msgid "Show password"
msgstr "نمایش گذرواژه"

msgid "Hide password"
msgstr "پنهان کردن گذرواژه"
