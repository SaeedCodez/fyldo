# Persian (Iran) translation of Fyldo.
# Tone: neutral-formal ("شما" is implicit; imperatives use the polite plural form). Reviewed by the project owner.
# Style (the pack's): the ezafe after a final «ه» is «‌ی» with a ZWNJ (صفحه‌ی), never the hamza-above form; "password" is «رمز عبور».
msgid ""
msgstr ""
"Project-Id-Version: Fyldo 1.0.0-beta.1\n"
"Report-Msgid-Bugs-To: https://wordpress.org/support/plugin/fyldo\n"
"Last-Translator: \n"
"Language-Team: Persian\n"
"Language: fa_IR\n"
"MIME-Version: 1.0\n"
"Content-Type: text/plain; charset=UTF-8\n"
"Content-Transfer-Encoding: 8bit\n"
"Plural-Forms: nplurals=2; plural=(n > 1);\n"
"X-Domain: fyldo\n"

msgid "Fyldo"
msgstr "فیلدو"

msgid "Settings-page framework for WordPress plugin developers. Declare pages, sections and fields in PHP; get a modern admin UI with REST-backed validation and saving."
msgstr "چارچوب صفحه‌ی تنظیمات برای توسعه‌دهندگان افزونه‌ی وردپرس. صفحه‌ها، بخش‌ها و فیلدها را در PHP تعریف کنید و یک رابط مدیریتی مدرن با اعتبارسنجی و ذخیره‌سازی از طریق REST دریافت کنید."

msgid "You have unsaved changes"
msgstr "تغییرات ذخیره‌نشده دارید"

msgid "Saving changes…"
msgstr "در حال ذخیره‌ی تغییرات…"

msgid "All changes saved"
msgstr "همه‌ی تغییرات ذخیره شد"

msgid "Couldn't save. Check your connection and try again."
msgstr "ذخیره نشد. اتصال خود را بررسی کنید و دوباره تلاش کنید."

msgid "Unsaved changes"
msgstr "تغییرات ذخیره‌نشده"

msgid "Discard"
msgstr "لغو تغییرات"

msgid "Save changes"
msgstr "ذخیره‌ی تغییرات"

msgid "This settings screen needs JavaScript. Please enable it and reload the page."
msgstr "این صفحه‌ی تنظیمات به جاوااسکریپت نیاز دارد. آن را فعال کنید و صفحه را دوباره بارگذاری کنید."

msgid "The values must be an object."
msgstr "مقادیر باید یک شیء باشند."

msgid "Some values are not valid."
msgstr "برخی مقادیر معتبر نیستند."

msgid "These settings were changed somewhere else. Reload to see the latest values."
msgstr "این تنظیمات در جای دیگری تغییر کرده‌اند. برای دیدن آخرین مقادیر، صفحه را دوباره بارگذاری کنید."

msgid "You must be logged in."
msgstr "باید وارد حساب کاربری خود شوید."

msgid "This settings page does not exist."
msgstr "این صفحه‌ی تنظیمات وجود ندارد."

msgid "Your session has expired. Reload the page and try again."
msgstr "نشست شما منقضی شده است. صفحه را دوباره بارگذاری کنید و دوباره تلاش کنید."

msgid "You are not allowed to change these settings."
msgstr "اجازه‌ی تغییر این تنظیمات را ندارید."

msgid "The request is too large."
msgstr "درخواست بیش از حد بزرگ است."

msgid "This field is required."
msgstr "این فیلد الزامی است."

msgid "Use at least %d character."
msgid_plural "Use at least %d characters."
msgstr[0] "دست‌کم %d نویسه وارد کنید."
msgstr[1] "دست‌کم %d نویسه وارد کنید."

msgid "Use no more than %d character."
msgid_plural "Use no more than %d characters."
msgstr[0] "حداکثر %d نویسه مجاز است."
msgstr[1] "حداکثر %d نویسه مجاز است."

msgid "This value is not in the expected format."
msgstr "قالب این مقدار درست نیست."

msgid "Enter a valid URL."
msgstr "یک نشانی اینترنتی معتبر وارد کنید."

msgid "Enter a valid email address."
msgstr "یک نشانی ایمیل معتبر وارد کنید."

msgid "Enter a number."
msgstr "یک عدد وارد کنید."

msgid "Enter a value in steps of %s."
msgstr "مقدار را با گام %s وارد کنید."

msgid "Choose one of the available options."
msgstr "یکی از گزینه‌های موجود را انتخاب کنید."

msgid "Enter a value of at least %s."
msgstr "مقداری دست‌کم برابر با %s وارد کنید."

msgid "Enter a value of at most %s."
msgstr "مقداری حداکثر برابر با %s وارد کنید."

msgid "This value is not valid."
msgstr "این مقدار معتبر نیست."

msgid "Select at least %d option."
msgid_plural "Select at least %d options."
msgstr[0] "دست‌کم %d گزینه را انتخاب کنید."
msgstr[1] "دست‌کم %d گزینه را انتخاب کنید."

msgid "Select no more than %d option."
msgid_plural "Select no more than %d options."
msgstr[0] "حداکثر %d گزینه را می‌توانید انتخاب کنید."
msgstr[1] "حداکثر %d گزینه را می‌توانید انتخاب کنید."

msgid "%d character remaining."
msgid_plural "%d characters remaining."
msgstr[0] "%d نویسه باقی مانده است."
msgstr[1] "%d نویسه باقی مانده است."

msgid "%d character over the limit."
msgid_plural "%d characters over the limit."
msgstr[0] "%d نویسه بیشتر از حد مجاز است."
msgstr[1] "%d نویسه بیشتر از حد مجاز است."

msgid "Remove %s"
msgstr "حذف %s"

msgid "%s removed"
msgstr "%s حذف شد"

msgid "Selection cleared"
msgstr "انتخاب‌ها پاک شد"

msgid "Clear all"
msgstr "پاک کردن همه"

msgid "Search…"
msgstr "جستجو…"

msgid "Search options"
msgstr "جستجوی گزینه‌ها"

msgid "No results found."
msgstr "نتیجه‌ای پیدا نشد."

msgid "%s selected"
msgid_plural "%s selected"
msgstr[0] "%s مورد انتخاب شده"
msgstr[1] "%s مورد انتخاب شده"

msgid "%s more selected"
msgid_plural "%s more selected"
msgstr[0] "%s مورد دیگر انتخاب شده"
msgstr[1] "%s مورد دیگر انتخاب شده"

msgid "Note"
msgstr "یادداشت"

msgid "Information"
msgstr "اطلاعات"

msgid "Success"
msgstr "موفقیت"

msgid "Warning"
msgstr "هشدار"

msgid "Error"
msgstr "خطا"

msgid "•••• set"
msgstr "•••• تنظیم شده"

msgid "A value is already saved. Leave this empty to keep it, or type a new one to replace it."
msgstr "مقداری از قبل ذخیره شده است. برای نگه داشتن آن این فیلد را خالی بگذارید، یا برای جایگزینی مقدار جدیدی وارد کنید."

#. translators: %s: version number of the plugin, e.g. 1.0
msgctxt "version badge"
msgid "v%s"
msgstr "%s"

msgid "(opens in a new tab)"
msgstr "(در زبانه‌ی تازه باز می‌شود)"

msgid "Resources"
msgstr "منابع"

msgid "Menu"
msgstr "منو"

# M5: the skip link, the first stop of the Tab order
msgid "Skip to page content"
msgstr "پرش به محتوای صفحه"

# M3 part 2: save patterns, the unsaved-changes dialog, conflicts. Texts drawn in the pack follow the pack
# (design/figma/components/save-bar.json, modal.json, section-card.json).
msgid "Couldn’t save. Check the highlighted fields."
msgstr "ذخیره نشد. فیلدهای مشخص‌شده را بررسی کنید."

msgid "Save"
msgstr "ذخیره"

msgid "Changes take effect after you save."
msgstr "تغییرات پس از ذخیره اعمال می‌شوند."

msgid "Discard unsaved changes?"
msgstr "تغییرات ذخیره‌نشده حذف شوند؟"

msgid "Your edits on this page haven’t been saved and will be lost."
msgstr "ویرایش‌های این صفحه ذخیره نشده‌اند و از بین می‌روند."

msgid "Keep editing"
msgstr "ادامه‌ی ویرایش"

msgctxt "unsaved changes dialog"
msgid "Discard"
msgstr "حذف تغییرات"

msgid "Close"
msgstr "بستن"

msgid "These settings were changed somewhere else"
msgstr "این تنظیمات در جای دیگری تغییر کرده‌اند"

msgid "They were saved in another tab or by another person after this page was opened, so your changes were not saved. Reload the latest values to continue; your unsaved changes on this page will be lost."
msgstr "این تنظیمات پس از باز شدن این صفحه در زبانه‌ی دیگری یا توسط شخص دیگری ذخیره شده‌اند، بنابراین تغییرات شما ذخیره نشد. برای ادامه، آخرین مقادیر را بارگذاری کنید؛ تغییرات ذخیره‌نشده‌ی شما در این صفحه از بین می‌روند."

msgid "Reload latest values"
msgstr "بارگذاری آخرین مقادیر"

msgid "Couldn’t save: these settings were changed somewhere else."
msgstr "ذخیره نشد: این تنظیمات در جای دیگری تغییر کرده‌اند."

msgid "Couldn’t load the latest values. Check your connection and try again."
msgstr "بارگذاری آخرین مقادیر انجام نشد. اتصال خود را بررسی کنید و دوباره تلاش کنید."

# Code-only design (docs/design-spec.md): the password show/hide toggle.
msgid "Show password"
msgstr "نمایش رمز عبور"

# M4 — feedback: toasts, notices, the Danger modal and the reset action (texts from the design pack where it has them)
msgid "Notifications"
msgstr "اعلان‌ها"

msgid "Dismiss"
msgstr "بستن اعلان"

msgid "Cancel"
msgstr "انصراف"

msgid "Retry"
msgstr "تلاش دوباره"

msgid "This action can’t be undone."
msgstr "این کار قابل بازگشت نیست."

msgid "Reset settings"
msgstr "بازنشانی تنظیمات"

msgid "Reset all settings?"
msgstr "همه‌ی تنظیمات بازنشانی شوند؟"

msgid "Every option on this page will return to its default value. This can’t be undone."
msgstr "همه‌ی گزینه‌های این صفحه به مقدار پیش‌فرض برمی‌گردند. این کار قابل بازگشت نیست."

msgid "Type %s to confirm"
msgstr "برای تأیید، «%s» را تایپ کنید"

msgid "Settings reset to defaults"
msgstr "تنظیمات به مقدار پیش‌فرض بازنشانی شد"

msgid "Couldn't reset settings. Check your connection and try again."
msgstr "بازنشانی تنظیمات انجام نشد. اتصال خود را بررسی کنید و دوباره تلاش کنید."

msgid "This action does not exist."
msgstr "این اقدام وجود ندارد."

msgid "The confirmation text does not match."
msgstr "متن تأیید مطابقت ندارد."

msgid "A live tour of what a settings screen built with Fyldo looks like."
msgstr "یک گشت زنده برای دیدن ظاهر صفحه‌ی تنظیمات ساخته‌شده با فیلدو."

msgid "A short sentence, up to 160 characters."
msgstr "یک جمله‌ی کوتاه، حداکثر ۱۶۰ نویسه."

msgid "API key"
msgstr "کلید API"

msgid "Access"
msgstr "دسترسی"

msgid "Account name"
msgstr "نام حساب"

msgid "All post types"
msgstr "همه‌ی نوع‌های نوشته"

msgid "Amounts"
msgstr "مقدارها"

msgid "Ask search engines to skip this site."
msgstr "از موتورهای جستجو بخواهید این سایت را نادیده بگیرند."

msgid "Authors"
msgstr "نویسندگان"

msgid "Between 5 and 100, in steps of 5."
msgstr "بین ۵ و ۱۰۰، با گام‌های ۵ تایی."

msgid "Boxed"
msgstr "جعبه‌ای"

msgid "Categories"
msgstr "دسته‌ها"

msgid "Checked by a rule that only runs on the server. Try “admin”."
msgstr "با قاعده‌ای بررسی می‌شود که فقط روی سرور اجرا می‌شود. «admin» را امتحان کنید."

msgid "Contact email"
msgstr "ایمیل تماس"

msgid "Content"
msgstr "محتوا"

msgid "Discourage indexing"
msgstr "جلوگیری از نمایه‌سازی"

msgid "Display"
msgstr "نمایش"

msgid "Documentation"
msgstr "مستندات"

msgid "Each card saves on its own."
msgstr "هر کارت جداگانه ذخیره می‌شود."

msgid "Each page shows different building blocks."
msgstr "هر صفحه بخش‌های سازنده‌ی متفاوتی را نشان می‌دهد."

msgid "English and فارسی"
msgstr "انگلیسی و فارسی"

msgid "Everything here is declared in PHP"
msgstr "همه‌ی این‌ها در PHP تعریف شده‌اند"

msgid "Excerpt length"
msgstr "طول چکیده"

msgid "Full width"
msgstr "تمام‌عرض"

msgid "Fyldo demo"
msgstr "دموی فیلدو"

msgid "General"
msgstr "عمومی"

msgid "Home address"
msgstr "نشانی صفحه‌ی اصلی"

msgid "How your site introduces itself."
msgstr "سایت شما چگونه خودش را معرفی می‌کند."

msgid "In words, between 10 and 200."
msgstr "بر حسب کلمه، بین ۱۰ و ۲۰۰."

msgid "Include in the sitemap"
msgstr "گنجاندن در نقشه‌ی سایت"

msgid "Index"
msgstr "نمایه شود"

msgid "Items per page"
msgstr "تعداد مورد در هر صفحه"

msgid "Keys, accounts and a way back to the defaults."
msgstr "کلیدها، حساب‌ها و راهی برای بازگشت به پیش‌فرض‌ها."

msgid "Language and indexing"
msgstr "زبان و نمایه‌سازی"

msgid "Layout"
msgstr "چیدمان"

msgid "Let search engines list this site."
msgstr "به موتورهای جستجو اجازه دهید این سایت را فهرست کنند."

msgid "License key"
msgstr "کلید مجوز"

msgid "Limits"
msgstr "محدودیت‌ها"

msgid "Maintenance mode"
msgstr "حالت تعمیر و نگهداری"

msgid "Managed by your hosting provider."
msgstr "توسط ارائه‌دهنده‌ی هاست شما مدیریت می‌شود."

msgid "My WordPress site"
msgstr "سایت وردپرسی من"

msgid "Not available in the demo."
msgstr "در نسخه‌ی دمو در دسترس نیست."

msgid "Nothing you type here leaves this site."
msgstr "هیچ‌چیزی که اینجا تایپ می‌کنید از این سایت خارج نمی‌شود."

msgid "Numbers are checked in the browser and again on the server."
msgstr "عددها هم در مرورگر و هم دوباره روی سرور بررسی می‌شوند."

msgid "Only https addresses are accepted."
msgstr "فقط نشانی‌های https پذیرفته می‌شوند."

msgid "Open demo"
msgstr "باز کردن دمو"

msgid "Overview"
msgstr "نمای کلی"

msgid "Page layout"
msgstr "چیدمان صفحه"

msgid "Pages"
msgstr "برگه‌ها"

msgid "Posts"
msgstr "نوشته‌ها"

msgid "Products"
msgstr "محصولات"

msgid "Report an issue"
msgstr "گزارش مشکل"

msgid "Restore every option on this page to its default value."
msgstr "همه‌ی گزینه‌های این صفحه را به مقدار پیش‌فرض بازمی‌گرداند."

msgid "Search engine visibility"
msgstr "نمایان‌بودن برای موتورهای جستجو"

msgid "Security"
msgstr "امنیت"

msgid "Select content types…"
msgstr "نوع‌های محتوا را انتخاب کنید…"

msgid "Settings"
msgstr "تنظیمات"

msgid "Show a coming-soon page to visitors. Administrators still see the site."
msgstr "یک صفحه‌ی «به‌زودی» به بازدیدکنندگان نشان داده می‌شود. مدیران همچنان سایت را می‌بینند."

msgid "Show on"
msgstr "نمایش در"

msgid "Show publish dates"
msgstr "نمایش تاریخ انتشار"

msgid "Shown in the browser tab and in search results."
msgstr "در زبانه‌ی مرورگر و نتایج جستجو نمایش داده می‌شود."

msgid "Site identity"
msgstr "هویت سایت"

msgid "Site language"
msgstr "زبان سایت"

msgid "Site title"
msgstr "عنوان سایت"

msgid "Tabs, checkbox groups, multi select and number fields, saved card by card."
msgstr "زبانه‌ها، گروه‌های چک‌باکس، چندانتخابی و فیلدهای عددی که کارت‌به‌کارت ذخیره می‌شوند."

msgid "Tagline"
msgstr "شعار"

msgid "Tags"
msgstr "برچسب‌ها"

msgid "Take the tour"
msgstr "گشتی بزنید"

msgid "Tools"
msgstr "ابزارها"

msgid "Welcome"
msgstr "خوش آمدید"

msgid "What is shown, where, and how much of it."
msgstr "چه چیزی، کجا و به چه اندازه نمایش داده شود."

msgid "Where to show it"
msgstr "کجا نمایش داده شود"

msgid "Write-only: once saved, the key is never sent back to the browser."
msgstr "فقط نوشتنی: پس از ذخیره، کلید دیگر به مرورگر فرستاده نمی‌شود."

msgid "Your site’s identity and how search engines see it."
msgstr "هویت سایت شما و نحوه‌ی دیده‌شدنش در موتورهای جستجو."

msgid "“admin” is reserved. Choose another name."
msgstr "«admin» رزرو شده است. نام دیگری انتخاب کنید."

msgid "This demo is only added when Fyldo is installed as a plugin. Return false from the fyldo/fyldo-demo/enabled filter to hide it."
msgstr "این دمو فقط وقتی اضافه می‌شود که فیلدو به‌صورت افزونه نصب شده باشد. برای پنهان کردن آن، فیلتر fyldo/fyldo-demo/enabled را false برگردانید."

msgid "Pages, sections and fields come from one array. Change a value, save it and reload: it is stored in a normal WordPress option."
msgstr "صفحه‌ها، بخش‌ها و فیلدها از یک آرایه می‌آیند. مقداری را تغییر دهید، ذخیره کنید و صفحه را دوباره باز کنید: در یک گزینه‌ی معمولی وردپرس ذخیره می‌شود."

msgid "The screen follows your language. Set your profile language to فارسی to see the right-to-left layout."
msgstr "این صفحه از زبان شما پیروی می‌کند. زبان نمایه‌ی خود را روی فارسی بگذارید تا چیدمان راست‌به‌چپ را ببینید."

msgid "Text, URL, email, textarea, toggle, select and radio fields with one Save Bar for the whole page."
msgstr "فیلدهای متن، نشانی، ایمیل، متن چندخطی، کلید، انتخاب و رادیو با یک نوار ذخیره برای کل صفحه."

msgid "A write-only password, a disabled field, a server-side rule and a Danger card that resets the page."
msgstr "یک رمز عبور فقط‌نوشتنی، یک فیلد غیرفعال، یک قاعده‌ی سمت سرور و یک کارت خطر که صفحه را بازنشانی می‌کند."
